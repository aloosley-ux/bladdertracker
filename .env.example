# Frontend / app shell
# Set to true to use the Vercel/Neon API instead of browser localStorage.
VITE_USE_CLOUD=
# Local/offline admin promotion key. Sign in, then open /?admin-access=<key> —
# the frontend reads it once and immediately scrubs it from the URL; in cloud
# mode the key is sent to the API in the x-admin-key request header.
VITE_ADMIN_KEY=

# API / serverless runtime
# Neon connection string (either variable name is accepted).
DATABASE_URL=
POSTGRES_URL=
# JWT signing secret for server-side sessions.
JWT_SECRET=
# Cloud-mode admin promotion key. POST /api/auth { action: 'promote' } with the
# key in the x-admin-key request header (never in the body or URL).
ADMIN_ACCESS_KEY=
NODE_ENV=development
# CORS allowed origin for the API (e.g. https://your-app.vercel.app).
# Falls back to VERCEL_URL (set automatically by Vercel) or localhost:5173 in dev.
ALLOWED_ORIGIN=

# Rate limiting (Upstash Redis). If unset, rate limiting is disabled (local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
