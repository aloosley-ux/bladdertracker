# Frontend / app shell
# Set to true to use the Vercel/Neon API instead of browser localStorage.
VITE_USE_CLOUD=
# Local/offline admin promotion key used with ?admin-access=<key>.
VITE_ADMIN_KEY=

# API / serverless runtime
# Neon connection string (either variable name is accepted).
DATABASE_URL=
POSTGRES_URL=
# JWT signing secret for server-side sessions.
JWT_SECRET=
# Cloud-mode admin promotion key used by POST /api/auth { action: 'promote' }.
ADMIN_ACCESS_KEY=
NODE_ENV=development
# CORS allowed origin for the API (e.g. https://your-app.vercel.app).
# Falls back to VERCEL_URL (set automatically by Vercel) or localhost:5173 in dev.
ALLOWED_ORIGIN=

# Rate limiting (Upstash Redis). If unset, rate limiting is disabled (local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
